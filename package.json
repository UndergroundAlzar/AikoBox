{
  "name": "aikobox",
  "version": "0.1.0-beta.1",
  "description": "Windows proxy client powered by sing-box with Clash YAML compatibility",
  "private": true,
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/UndergroundAlzar/AikoBox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UndergroundAlzar/AikoBox.git"
  },
  "bugs": {
    "url": "https://github.com/UndergroundAlzar/AikoBox/issues"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "author": "UndergroundAlzar",
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run",
    "smoke:runtime": "node --import tsx scripts/runtime-smoke.mjs",
    "test:electron-smoke": "node --test scripts/electron-ci-smoke.test.mjs",
    "test:electron-prod-smoke": "node --test scripts/electron-production-ci-smoke.test.mjs",
    "smoke:electron:ci": "node scripts/electron-ci-smoke.mjs",
    "smoke:electron:prod:ci": "node scripts/electron-production-ci-smoke.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --list-different .",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "review": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run audit:i18n",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "prepare": "pnpm run hooks:install && node scripts/prepare.mjs",
    "prepare:dev": "pnpm run hooks:install && node scripts/update-version.mjs && node scripts/prepare.mjs",
    "checksum": "node scripts/checksum.mjs",
    "clean:release-output": "node scripts/clean-release-output.mjs",
    "verify:retired-output": "node scripts/verify-retired-output.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:verify-release": "node --test scripts/verify-release.test.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "test:licenses": "node --test scripts/audit-licenses.test.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test:i18n": "node --test scripts/audit-i18n.test.mjs",
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-vite build",
    "package:win": "pnpm run clean:release-output && pnpm run build && pnpm run verify:retired-output && electron-builder --publish never --win --x64",
    "build:win": "pnpm run package:win && pnpm run checksum",
    "build:win:dev": "pnpm run prepare:dev && pnpm run build:win"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/plist": "^3.0.5",
    "adm-zip": "^0.5.17",
    "age-encryption": "^0.3.0",
    "axios": "^1.18.0",
    "chokidar": "^5.0.0",
    "croner": "^9.1.0",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "file-icon": "^6.0.0",
    "file-icon-info": "^1.1.1",
    "flag-icons": "^7.5.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "i18next": "^26.3.1",
    "iconv-lite": "^0.7.2",
    "js-yaml": "^4.2.0",
    "plist": "^3.1.1",
    "qrcode.react": "^4.2.0",
    "sysproxy-rs": "file:src\\native\\sysproxy",
    "validator": "^13.15.35",
    "webdav": "^5.10.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@heroui/react": "^2.8.10",
    "@tailwindcss/vite": "^4.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.9.4",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^5.2.0",
    "chart.js": "^4.5.1",
    "cron-validator": "^1.4.0",
    "dayjs": "^1.11.21",
    "driver.js": "^1.4.0",
    "electron": "^41.8.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "4.0.1",
    "electron-window-state": "^5.0.3",
    "eslint": "9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "form-data": "^4.0.6",
    "framer-motion": "12.23.26",
    "lodash": "^4.18.1",
    "meta-json-schema": "^1.19.27",
    "monaco-yaml": "^5.5.1",
    "nanoid": "^5.1.15",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "pubsub-js": "^1.9.5",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^16.6.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-monaco-editor": "^0.59.0",
    "react-router-dom": "^7.18.0",
    "react-virtuoso": "^4.18.7",
    "swr": "^2.4.1",
    "tailwindcss": "^4.3.1",
    "tar": "^7.5.16",
    "tsx": "^4.22.4",
    "types-pac": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "byte-length@1.0.2": "file:src/native/byte-length"
    },
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
